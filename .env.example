# ──────────────────────────────────────────────────────────────
# RUST WAR NEWS 환경변수 예시 — 복사해서 .env 로 사용 (실제 값은 커밋 금지)
# ──────────────────────────────────────────────────────────────

# DB 연결
#  - 운영(Vercel): Neon 대시보드의 "Pooled connection" 문자열
#      postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#  - 로컬 개발/테스트: 내장 PostgreSQL(PGlite) 폴더
#      pglite:./.pglite-dev
DATABASE_URL=pglite:./.pglite-dev

# 세션·IP 해시·투표자 식별용 비밀값 (32자 이상 무작위 문자열)
#   생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# 사이트 공개 주소 (Origin 검사, Twitch 클립 임베드 parent 값에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 선택: 세션 유지 시간(시간), 업로드 최대 크기(MB), 실시간 폴링 주기(ms)
# SESSION_TTL_HOURS=12
# UPLOAD_MAX_MB=3
# NEXT_PUBLIC_LIVE_POLL_MS=4000

# ── 일회성 초기화 스크립트용 (npm run db:init-admin) ─────────────
# 최초 SUPER_ADMIN 생성 후 반드시 ADMIN_INITIAL_PASSWORD 를 삭제하세요.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME=RWN관리자

# ── 진행자 계정 기본 등록 (npm run db:seed-anchors) ──────────────
# 형식: 이름:이메일,이름:이메일  (임시 비밀번호는 실행 시 한 번만 출력)
SEED_ANCHORS=난워니:nanwony@example.com,김옥독:kimokdok@example.com
